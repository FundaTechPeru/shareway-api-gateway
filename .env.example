# Copy to .env (never commit it) and replace every value marked as change-me.

# Port of the gateway on the host and the URL clients use to reach it; the OpenAPI documents
# point "Try it out" there.
PORT=8000
GATEWAY_PORT=8000
PUBLIC_URL=http://localhost:8000

# HS256 secret shared with the monolith and every extracted service (at least 32 bytes).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Upstreams. Every service has left the monolith, so UPSTREAM_MONOLITH is no longer read by any
# route; it can stay empty. Each path prefix answers 503 until its own variable is set.
UPSTREAM_MONOLITH=
# Driver Management: docker compose uses its own driver-management container when this is empty.
UPSTREAM_DRIVER_MANAGEMENT=http://localhost:8081
# Payments & Settlement, Trip Planning & Matching and Booking & Pricing left the monolith as well
# (same rules as Driver Management). Trip Planning listens on 8081 by default, like Driver
# Management: on the host start it with SERVER_PORT=8083; Booking & Pricing defaults to 8080, so
# start it with SERVER_PORT=8084 to avoid clashing with the others.
UPSTREAM_PAYMENTS_SETTLEMENT=http://localhost:8085
UPSTREAM_TRIP_PLANNING_MATCHING=http://localhost:8083
UPSTREAM_BOOKING_PRICING=http://localhost:8084
# Trip Execution never lived in the monolith; /api/v1/trips answers 503 until this is set.
# From docker compose, a service on the host is http://host.docker.internal:<port>.
UPSTREAM_TRIP_EXECUTION=

# Resilience, limits and logs.
UPSTREAM_TIMEOUT_MS=10000
CIRCUIT_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_VOLUME_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
LOG_LEVEL=info

# Only for docker compose: the databases and the extracted services. Payments & Settlement reads
# INTERNAL_API_KEY; Driver Management creates the administrator on startup when both values are
# set.
DB_USER=shareway
DB_PASSWORD=change-me
INTERNAL_API_KEY=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
