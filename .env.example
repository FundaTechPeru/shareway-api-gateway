# Copy to .env (never commit it) and replace every value marked as change-me.

# Port of the gateway on the host and the URL clients use to reach it; the OpenAPI documents
# point "Try it out" there.
PORT=8000
GATEWAY_PORT=8000
PUBLIC_URL=http://localhost:8000

# HS256 secret shared with the monolith and every extracted service (at least 32 bytes).
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-bytes

# Upstreams. The monolith serves every service until the variable of that service is set to the
# URL of its extracted version. docker compose always uses its own monolith container.
UPSTREAM_MONOLITH=http://localhost:8080
# Driver Management left the monolith: its paths answer 503 until this is set. docker compose
# uses its own driver-management container when it is empty.
UPSTREAM_DRIVER_MANAGEMENT=http://localhost:8081
# Payments & Settlement and Trip Planning & Matching left the monolith as well (same rules as
# Driver Management). Trip Planning listens on 8081 by default, like Driver Management: on the
# host start it with SERVER_PORT=8083.
UPSTREAM_PAYMENTS_SETTLEMENT=http://localhost:8085
UPSTREAM_TRIP_PLANNING_MATCHING=http://localhost:8083
UPSTREAM_BOOKING_PRICING=
# Trip Execution never lived in the monolith; /api/v1/trips answers 503 until this is set.
# From docker compose, a service on the host is http://host.docker.internal:<port>.
UPSTREAM_TRIP_EXECUTION=

# Resilience, limits and logs.
UPSTREAM_TIMEOUT_MS=10000
CIRCUIT_ERROR_THRESHOLD_PERCENT=50
CIRCUIT_VOLUME_THRESHOLD=5
CIRCUIT_RESET_TIMEOUT_MS=30000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
TRUST_PROXY=false
LOG_LEVEL=info

# Only for docker compose: the databases, the monolith and the extracted services. Payments &
# Settlement and the monolith share INTERNAL_API_KEY; Driver Management creates the administrator
# on startup when both values are set.
DB_USER=shareway
DB_PASSWORD=change-me
INTERNAL_API_KEY=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=
