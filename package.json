{
  "name": "shareway-api-gateway",
  "version": "0.0.1",
  "description": "API gateway of ShareWay: single entry point in front of the monolith and the extracted services (Strangler Fig).",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "gts lint",
    "fix": "gts fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "gts": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "http-proxy-middleware": "^4.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
